Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Legacy PHP page URLs now resolve through the React app.
RewriteRule ^(.+)\.php$ index.html [L]

# Serve built assets directly and send all app routes (including old .php links) to React.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
